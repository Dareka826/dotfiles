#!/usr/bin/luajit
-- vim: ft=lua sw=4 ts=4 et

-- User Vars

CC = nil
CFLAGS = "-Wall -Wextra -Wno-unused-parameter -Wconversion -std=c99"

TRY_CLANG_FORMAT = false

-- Vars

---@alias target "top"|"pre"|"main"|"post"

---@type { [target]: string[] }
PROG = {
    top = {},
    pre = {},
    main = {},
    post = {},
}

---@type target
TARGET = "main"

---@type { [string]: (fun(): nil) }
COMMANDS = {}

---@type { [string]: string }
DESCRIPTIONS = {}

INDENT = "    "

AVAIL_CMD = {}

-- Functions

---@param str string
---@return string
local function shquote(str)
    return "'" .. string.gsub(str, "'", "'\\''") .. "'"
end

---@param t { [string]: any }
---@param key string
---@return boolean
local function has_key(t, key)
    -- {{{
    for k, _ in pairs(t) do
        if k == key then
            return true
        end
    end

    return false
end -- }}}

---@param cmd string
---@return boolean
local function iscmd(cmd)
    -- {{{
    if has_key(AVAIL_CMD, cmd) then
        return AVAIL_CMD[cmd]
    end

    local ret = os.execute("command -v " .. shquote(cmd) .. " >/dev/null 2>&1")
    local ok = (ret == 0)
    AVAIL_CMD[cmd] = ok
    return ok
end -- }}}


---@return nil
local function reset()
    -- {{{
    PROG.top = {
        "#include <stdlib.h>",
        "#include <stdio.h>",
    }

    PROG.pre = {}
    PROG.main = {}
    PROG.post = {}

    TARGET = "main"
end -- }}}

---@return string[]
local function generate()
    -- {{{
    local ret = {}

    for _, line in ipairs(PROG.top) do
        table.insert(ret, line)
    end

    table.insert(ret, "")

    for _, line in ipairs(PROG.pre) do
        table.insert(ret, line)
    end

    table.insert(ret, "")

    table.insert(ret, "int main(int argc, char *argv[]) {")

    for _, line in ipairs(PROG.main) do
        table.insert(ret, INDENT .. line)
    end

    table.insert(ret, INDENT .. "return 0;")
    table.insert(ret, "}")

    table.insert(ret, "")

    for _, line in ipairs(PROG.post) do
        table.insert(ret, line)
    end

    return ret
end -- }}}

---@return nil
local function run()
    -- {{{
    assert(CC ~= nil)
    local lines = generate()

    local name = os.tmpname()
    local f = io.open(name, "w")
    assert(f ~= nil)

    for _, line in ipairs(lines) do
        f:write(line .. "\n")
    end
    f:close()

    -- Compile
    local outfile = os.getenv("HOME") .. "/.cache/.crepl"
    local ret = os.execute(CC .. " " .. CFLAGS .. " -xc " .. shquote(name) .. " -o " .. shquote(outfile))

    if ret ~= 0 then
        io.stderr:write("[E]: Compilation error!\n")
    else
        os.execute(shquote(outfile))
        os.remove(outfile)
    end

    os.remove(name)
end -- }}}

---@return nil
local function pprint()
    -- {{{
    local name = os.tmpname()

    -- Try format
    if TRY_CLANG_FORMAT and iscmd("clang-format") then
        local clang_fmt = io.popen("clang-format --style=\"file:${HOME}/clang-format.yaml\" >" .. shquote(name), "w")
        assert(clang_fmt ~= nil)

        for _, l in ipairs(generate()) do
            clang_fmt:write(l .. "\n")
        end

        clang_fmt:close()
    else
        local f = io.open(name, "w")
        assert(f ~= nil)

        for _, l in ipairs(generate()) do
            f:write(l .. "\n")
        end

        f:close()
    end

    -- Try bat, else just cat
    if iscmd("bat") then
        os.execute("bat -lc --style=plain <" .. shquote(name))
    else
        os.execute("cat <" .. shquote(name))
    end

    os.remove(name)
end -- }}}

---@return nil
local function print_bufs()
    -- {{{
    ---@param buf string[]
    ---@return nil
    local function print_buf(buf)
        -- {{{
        local cat_n = io.popen("cat -n", "w")
        assert(cat_n ~= nil)

        for _, l in ipairs(buf) do
            cat_n:write(l .. "\n")
        end

        cat_n:close()
    end -- }}}

    print("// BUFFER: Top")
    print_buf(PROG.top)

    print("// BUFFER: Pre")
    print_buf(PROG.pre)

    print("// BUFFER: Main")
    print_buf(PROG.main)

    print("// BUFFER: Post")
    print_buf(PROG.main)
end -- }}}

---@return nil
local function sed_edit()
    -- {{{
    io.stdout:write("sed> ")
    io.stdout:flush()
    local line = io.stdin:read()

    -- EOF
    if line == nil then
        return
    end

    local name = os.tmpname()
    local f = io.open(name, "w")
    assert(f ~= nil)

    for _, l in ipairs(PROG[TARGET]) do
        f:write(l .. "\n")
    end
    f:close()

    line = shquote(line)
    local sed_f = io.popen("sed -e " .. line .. " <" .. shquote(name) .. " ; printf '%s\\n' \"$?\"", "r")
    if sed_f == nil then os.remove(name) end
    assert(sed_f ~= nil)

    local new_buf = {}
    for l in sed_f:lines() do
        table.insert(new_buf, l)
    end
    sed_f:close()
    os.remove(name)

    local status = table.remove(new_buf)
    if status == "0" then
        PROG[TARGET] = new_buf
    else
        io.stderr:write("[I]: Buffer not modified\n")
    end
end -- }}}

---@return nil
local function help()
    -- {{{
    for cmd, desc in pairs(DESCRIPTIONS) do
        print("." .. cmd .. " - " .. desc)
    end
end -- }}}

---@param name string
---@param aliases string[]
---@param desc string
---@param fn fun(): nil
local function add_cmd(name, aliases, desc, fn)
    -- {{{
    DESCRIPTIONS[name] = desc
    COMMANDS[name] = fn

    for _, a in pairs(aliases) do
        COMMANDS[a] = fn
    end
end -- }}}

-- Find C compiler or check provided one {{{
if CC == nil then
    if     iscmd("gcc")   then CC = "gcc"
    elseif iscmd("clang") then CC = "clang"
    elseif iscmd("cc")    then CC = "cc"
    else
        io.stderr:write("[E]: No C compiler found!\n")
        os.exit(1)
    end
else
    if not iscmd(CC) then
        io.stderr:write("[E]: Provided C compiler not found!\n")
        os.exit(1)
    end
end -- }}}

-- Add commands {{{
add_cmd(
    "quit",
    {"q", "exit"},
    "Exit crepl",
    function() os.exit(0) end
)

add_cmd(
    "top",
    {"t"},
    "Switch to the \"top\" section",
    function() TARGET = "top" end
)

add_cmd(
    "pre",
    {"pr", "before", "b"},
    "Switch to the \"pre\" section (before main)",
    function() TARGET = "pre" end
)

add_cmd(
    "main",
    {"m"},
    "Switch to inside main",
    function() TARGET = "main" end
)

add_cmd(
    "post",
    {"ps", "end", "e", "after", "a"},
    "Switch to the \"post\" section (after main)",
    function() TARGET = "post" end
)


add_cmd(
    "reset",
    {"clear", "c"},
    "Reset buffers to initial state",
    reset
)

add_cmd(
    "run",
    {"r"},
    "Compile and run the program",
    run
)

add_cmd(
    "print",
    {"p"},
    "Print the buffer",
    pprint
)

add_cmd(
    "help",
    {"h"},
    "Print this help",
    help
)

add_cmd(
    "bprint",
    {"bufprint", "bp", "printbuf", "printb", "pb"},
    "Print buffers' contents",
    print_bufs
)

add_cmd(
    "selected",
    {"sel", "s"},
    "Print selected buffer",
    function() print(TARGET) end
)

add_cmd(
    "sed",
    {},
    "Modify a buffer with sed",
    sed_edit
)
-- }}}

reset()

-- Main loop {{{
while true do
    -- Prompt
    io.stdout:write("> ")
    io.stdout:flush()

    local line = io.stdin:read()

    -- EOF
    if line == nil then
        print()
        break
    end

    -- Handle commands
    if string.sub(line, 1, 1) == "." then
        local cmd = string.sub(line, 2)

        -- If starts with .. then ignore first . and treat as non-command
        if string.sub(line, 1, 2) == ".." then
            table.insert(PROG[TARGET], string.sub(line, 2))

        elseif has_key(COMMANDS, cmd) then
            COMMANDS[cmd]()

        else
            io.stderr:write("[E]: Unknown command: " .. cmd .. "\n")
        end
    else
        table.insert(PROG[TARGET], line)
    end

    io.stdout:flush()
    io.stderr:flush()
end
-- }}}
